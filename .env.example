# URL pública final, sin slash al final. Ejemplo: https://tudominio.com
NEXT_PUBLIC_SITE_URL=

# URL HTTPS real de Calendly: abre desde los CTAs y después del formulario
# Sin configurar (o con URL inválida), los CTAs llevan al formulario #contacto
NEXT_PUBLIC_CALENDLY_URL=
# URL HTTPS real de Calendly para las landings /demo y /sesion-estrategica
NEXT_PUBLIC_DEMO_BOOKING_URL=
# URL HTTPS real de la sesión estratégica; sin configurar, usa /#contacto
NEXT_PUBLIC_STRATEGY_BOOKING_URL=
# URL HTTPS verificada de Loom para /demo; sin configurar, la sección no se muestra
NEXT_PUBLIC_DEMO_LOOM_URL=

# Google Analytics 4. Ejemplo de formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend: estas variables solo existen en el servidor
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

GOOGLE_SHEETS_WEBHOOK_URL=
DBN_FORM_SECRET=
